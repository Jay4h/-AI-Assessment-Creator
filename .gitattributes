# Normalize line endings to LF (cross-platform monorepo)
* text=auto eol=lf

# Windows scripts that require CRLF
*.{cmd,bat} text eol=crlf

# Binary assets — do not modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
